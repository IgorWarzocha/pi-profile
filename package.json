{
  "name": "pi-profile",
  "private": true,
  "description": "A multi-machine activity profile for Pi sessions, displayed with Lakebed",
  "license": "MIT",
  "repository": "github:IgorWarzocha/pi-profile",
  "type": "module",
  "scripts": {
    "aggregate": "node src/server-aggregate.js",
    "build": "lakebed build capsule --target anonymous",
    "preview": "lakebed dev capsule",
    "deploy": "cd capsule && lakebed deploy",
    "claim": "cd capsule && lakebed claim",
    "publish": "npm run aggregate && npm run deploy",
    "test": "node --test"
  },
  "devDependencies": {
    "lakebed": "0.0.31"
  },
  "engines": {
    "node": ">=20"
  }
}
