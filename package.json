{
  "name": "pi-profile",
  "private": true,
  "description": "One Pi activity profile published to Lakebed and ChatGPT Sites",
  "license": "MIT",
  "repository": "github:IgorWarzocha/pi-profile",
  "type": "module",
  "scripts": {
    "aggregate": "node src/server-aggregate.js",
    "build": "npm run build:lakebed && npm run build:sites",
    "build:lakebed": "node src/prepare-lakebed.js && lakebed build capsule --target anonymous",
    "build:sites": "vinext build",
    "typecheck": "vinext typegen && tsc --noEmit",
    "check": "npm test && npm run typecheck && npm run build",
    "dev:sites": "vinext dev",
    "preview": "node src/prepare-lakebed.js && lakebed dev capsule",
    "deploy": "node src/prepare-lakebed.js && cd capsule && lakebed deploy",
    "claim": "cd capsule && lakebed claim",
    "publish:lakebed": "npm run aggregate && npm run build:lakebed && npm run deploy",
    "test": "node --test"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "vinext": "1.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "lakebed": "0.0.40",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "fflate": "0.7.5"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
